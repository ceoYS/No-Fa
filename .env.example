# NoF RC-17 — environment variable NAMES ONLY. Never put real secrets here. Copy to `.env` (gitignored)
# and fill locally; server secrets go to Supabase, not to this file. Do NOT paste keys into chat.

# ── CLIENT (Vite) — inlined into the browser bundle. Must be PUBLIC-safe. ─────────────────────────
# The Supabase anon key is public by design; Row Level Security guards the data. NEVER place a
# service-role key or any provider (OpenAI) key behind a VITE_ prefix — that would ship it to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── SERVER-ONLY (Supabase Edge Function secrets) — NEVER VITE_-prefixed, never in the client bundle ──
# Set with the Supabase CLI, e.g.:  supabase secrets set OPENAI_API_KEY=sk-...  CLEANUP_SECRET=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into deployed functions by Supabase;
# set them locally only for `supabase functions serve`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Shared secret guarding the scheduled plaza-cleanup function (sent as the x-cleanup-secret header).
CLEANUP_SECRET=

# ── IMAGE COST GUARD (RC-17C §6) — SERVER-ONLY. NEVER VITE_-prefixed (these must never ship to the
# browser). Read by the generate-future-image edge function. EVERY gate FAILS CLOSED when unset, so
# paid image generation stays OFF until you deliberately enable AND budget it. Set as Supabase function
# secrets: supabase secrets set NAME=value  (same channel as OPENAI_API_KEY).
# Master kill-switch: generation is OFF unless this is exactly true / 1 / yes / on.
NOF_IMAGE_GENERATION_ENABLED=
# Hard ceiling on SUCCESSFUL generations across ALL users per day — the anonymous-signup cost backstop
# (a per-user cap can't bound unlimited free accounts). Unset/0/invalid = fail closed (no generation).
NOF_IMAGE_GLOBAL_DAILY_LIMIT=
# Per-user monthly included generations (server authority; the client ledger is UX-only). Unset =>
# the in-DB default (FREE = 1). PRO needs a server entitlement source (not in this milestone).
NOF_IMAGE_USER_MONTHLY_FREE_LIMIT=
NOF_IMAGE_USER_MONTHLY_PRO_LIMIT=
